@Library("shared_lib") _
pipeline {
    agent { label "agent_jenkin" }

    stages {
        stage('code') {
            steps {
                script{
                clone("https://github.com/Ajaylogaom1/Restuarant_app_docker.git" ,"main")
                }
            }
        }
        stage('build') {
            steps {
                 script{
                     docker_build("restuarant_app","latest","logaomajay")
                 }
            }
        }
        stage('push code in dockerhub') {
            steps {
                script{
                    docker_push("restuarant_app","latest","logaomajay")
                }
            }
        }
        stage('deploy'){
            steps {
                script{
                    docker_compose()
                }
            }
        }
    }
}
